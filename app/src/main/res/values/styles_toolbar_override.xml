<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App-module override of termux-shared toolbar title/subtitle appearance:
         white text so it reads on the purple primary toolbar in the AI theme. -->
    <style name="TextAppearance.Widget.BaseToolbar.Title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ai_text</item>
    </style>

    <style name="TextAppearance.Widget.BaseToolbar.Subtitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ai_text_muted</item>
    </style>
</resources>
