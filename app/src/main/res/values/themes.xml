<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!-- TermuxApp Light DarkActionBar theme. -->
    <style name="Theme.TermuxApp.Light.DarkActionBar" parent="Theme.BaseActivity.Light.DarkActionBar"/>
    <!-- TermuxApp Light NoActionBar theme. -->
    <style name="Theme.TermuxApp.Light.NoActionBar" parent="Theme.BaseActivity.Light.NoActionBar"/>

    <!-- TermuxApp DayNight DarkActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar"/>
    <!-- TermuxApp DayNight NoActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.NoActionBar"/>


    <!-- TermuxActivity DayNight NoActionBar theme. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>

        <item name="android:windowBackground">@color/black</item>

        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer. -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Light</item>
        <item name="termuxActivityDrawerBackground">@color/white</item>
        <item name="termuxActivityDrawerImageTint">@color/black</item>

        <!-- Extra keys colors. -->
        <item name="extraKeysButtonTextColor">@color/white</item>
        <item name="extraKeysButtonActiveTextColor">@color/red_400</item>
        <item name="extraKeysButtonBackgroundColor">@color/black</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/grey_500</item>
    </style>

    <style name="Theme.AiWorkspace" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ai_accent</item>
        <item name="colorPrimaryVariant">@color/ai_accent_dark</item>
        <item name="colorSecondary">@color/ai_accent</item>
        <item name="colorOnPrimary">@color/ai_text</item>
        <item name="colorSurface">@color/ai_surface</item>
        <item name="colorOnSurface">@color/ai_text</item>
        <item name="colorError">@color/ai_error</item>
        <item name="android:textColorPrimary">@color/ai_text</item>
        <item name="android:textColorSecondary">@color/ai_text_muted</item>
        <item name="android:textColorTertiary">@color/ai_text_muted</item>
        <item name="android:colorBackground">@color/ai_background</item>
        <item name="android:windowBackground">@color/ai_background</item>
        <item name="android:statusBarColor">@color/ai_background</item>
        <item name="android:navigationBarColor">@color/ai_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarDividerColor">@color/ai_divider</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialAlertDialogTheme">@style/AiMaterialAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/AiBottomSheetDialog</item>
        <item name="actionBarTheme">@style/AiActionBarTheme</item>
    </style>

    <style name="AiActionBarTheme" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/ai_text</item>
        <item name="android:textColorSecondary">@color/ai_text</item>
        <item name="colorControlNormal">@color/ai_text</item>
    </style>

    <!-- Dark neon alert dialogs (approval, model list, route picker, etc). -->
    <style name="AiMaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/ai_surface</item>
        <item name="colorOnSurface">@color/ai_text</item>
        <item name="colorPrimary">@color/ai_accent</item>
        <item name="colorSecondary">@color/ai_accent</item>
        <item name="colorError">@color/ai_error</item>
        <item name="android:colorBackground">@color/ai_background</item>
        <item name="materialAlertDialogTitleTextStyle">@style/AiAlertDialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AiAlertDialogBodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/AiDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AiDialogButtonMuted</item>
        <item name="buttonBarNeutralButtonStyle">@style/AiDialogButtonMuted</item>
    </style>

    <style name="AiAlertDialogTitleText" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/ai_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AiAlertDialogBodyText" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/ai_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AiDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/ai_accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AiDialogButtonMuted" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/ai_text_muted</item>
    </style>

    <style name="AiBottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AiBottomSheet</item>
        <item name="android:colorBackground">@color/ai_surface</item>
    </style>

    <style name="AiBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@color/ai_surface</item>
    </style>

</resources>
