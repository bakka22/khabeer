        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="12dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_provider_anthropic" /><TextView android:text="Anthropic" android:textColor="@color/ai_text" android:textSize="12sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" /><TextView android:text="https://api.anthropic.com" android:textColor="@color/ai_text_muted" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
