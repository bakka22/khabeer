    </LinearLayout>
    <TextView android:text="API Providers" android:textColor="@color/ai_text" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
