        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ai_divider" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp"><TextView android:text="◉" android:textColor="#7B61FF" android:textSize="18sp" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" /><TextView android:text="API Providers" android:textColor="@color/ai_text" android:textSize="13sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" /><TextView android:text="›" android:textColor="@color/ai_text_muted" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
