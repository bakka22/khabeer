<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_gradient_main" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ai_attach" android:rotation="180" /><TextView android:text="Report" android:textColor="@color/ai_text" android:textSize="16sp" android:textStyle="bold" android:layout_marginStart="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1E1A3A" android:orientation="horizontal" android:layout_marginTop="12dp"><TextView android:text="Summary" android:textColor="@color/ai_text" android:background="@color/ai_accent" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" /><TextView android:text="Details" android:textColor="@color/ai_text_muted" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" /><TextView android:text="System" android:textColor="@color/ai_text_muted" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#3D1F2E" android:padding="12dp" android:orientation="vertical" android:layout_marginTop="12dp"><TextView android:text="⚠  Crash detected" android:textColor="#FF6B7A" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" /><TextView android:text="NullPointerException\nAttempt to invoke virtual method\n'int android.X.TextView.indexOf(...)'\non null object reference" android:textColor="#FF8A9A" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
    <TextView android:text="What happened?" android:textColor="@color/ai_text" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="The app crashed while processing\nyour request. You can help us fix\nthis by sending this report." android:textColor="@color/ai_text_muted" android:textSize="11sp" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="Attachments" android:textColor="@color/ai_text" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="• log.txt\n• system_info.json" android:textColor="@color/ai_text_muted" android:textSize="11sp" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:text="Send report" android:textColor="@android:color/white" android:background="@color/ai_accent" android:gravity="center" android:padding="14dp" android:textSize="13sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Preview (Markdown)" android:textColor="@color/ai_text_muted" android:gravity="center" android:padding="12dp" android:textSize="11sp" android:background="@drawable/bg_provider_card" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
