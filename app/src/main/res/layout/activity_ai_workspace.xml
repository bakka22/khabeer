<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_main"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ai_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ai_harness_badge"
                android:src="@drawable/ic_khabeer_logo"
                android:padding="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:text="khabeer"
                    android:textColor="@color/ai_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Your AI agent on Android"
                    android:textColor="@color/ai_text_muted"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/ai_menu_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ai_menu"
                app:tint="@color/ai_text_muted"
                android:contentDescription="@string/ai_open_drawer" />

            <ImageButton
                android:id="@+id/ai_settings_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                app:tint="@color/ai_text"
                android:contentDescription="@string/ai_settings_label" />
        </LinearLayout>

        <TextView android:id="@+id/ai_chat_title" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/ai_chat_subtitle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        <FrameLayout
            android:id="@+id/ai_page_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/ai_more_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_main"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ai_more_page"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </androidx.core.widget.NestedScrollView>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/ai_home_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="100dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <TextView
                        android:id="@+id/ai_home_title_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_home_title"
                        android:textColor="@color/ai_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ai_home_body_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/ai_home_body"
                        android:textColor="@color/ai_text_muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <LinearLayout
                        android:id="@+id/ai_harness_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/ai_setup_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_main"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageButton android:id="@+id/ai_setup_back" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_ai_attach" android:rotation="90" app:tint="@color/ai_text" />
                        <TextView android:id="@+id/ai_setup_title" android:text="Setup OpenAI" android:textColor="@color/ai_text" android:textSize="16sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" />
                        <View android:layout_width="40dp" android:layout_height="40dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp" android:background="@drawable/bg_provider_card" android:padding="14dp">
                        <ImageView android:id="@+id/ai_selected_harness_icon" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_ai_harness_badge" android:src="@drawable/ic_provider_openai" android:padding="8dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:id="@+id/ai_selected_harness_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ai_text" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:id="@+id/ai_selected_harness_body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ai_text_muted" android:textSize="12sp" android:maxLines="2" />
                        </LinearLayout>
                        <TextView android:text="Configured" android:textColor="@color/ai_success" android:background="@drawable/bg_ai_chip" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView android:id="@+id/ai_harness_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_ai_chip" android:padding="10dp" android:gravity="center" android:textColor="@color/ai_text_muted" android:textSize="12sp" android:visibility="gone" />

                    <TextView android:text="Workspace" android:textColor="@color/ai_text" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/ai_workspace_input_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/ai_workspace_hint" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp" app:boxStrokeColor="@color/ai_border" app:hintTextColor="@color/ai_text_muted">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_workspace_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ai_text" android:textSize="13sp" android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/ai_browse_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="@string/ai_browse" android:textAllCaps="false" app:cornerRadius="14dp" app:strokeColor="@color/ai_border" app:icon="@drawable/ic_ai_folder" />

                    <TextView android:text="Account" android:textColor="@color/ai_text" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/ai_login_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="@string/ai_sign_in" android:textAllCaps="false" app:cornerRadius="14dp" app:strokeColor="@color/ai_border" app:icon="@drawable/ic_ai_login" />
                    <TextView android:id="@+id/ai_setup_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="@color/ai_text_muted" android:textSize="12sp" />

                    <TextView android:text="Model" android:textColor="@color/ai_text" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_provider_card" android:padding="12dp" android:gravity="center_vertical" android:layout_marginTop="8dp">
                        <TextView android:id="@+id/ai_model_display" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="gpt-4o" android:textColor="@color/ai_text" android:textSize="13sp" />
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_ai_menu" app:tint="@color/ai_text" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton android:id="@+id/ai_start_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="@string/ai_continue" android:textAllCaps="false" app:cornerRadius="16dp" android:backgroundTint="@color/ai_accent" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout android:id="@+id/ai_chat_page" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient_main" android:orientation="vertical" android:visibility="gone">

                <androidx.core.widget.NestedScrollView android:id="@+id/ai_conversation_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_provider_card" android:padding="14dp" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:text="👋" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
                                <TextView android:text="Hi! I'm your AI coding agent." android:textColor="@color/ai_text" android:textSize="13sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                                <TextView android:text="How can I help you build today?" android:textColor="@color/ai_text_muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center">
                            <TextView android:id="@+id/ai_suggestion_project_plan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/bg_ai_suggestion" android:padding="12dp" android:text="Create a project plan\nfor this repo" android:textColor="@color/ai_text" android:textSize="12sp" android:clickable="true" android:focusable="true" />
                            <TextView android:id="@+id/ai_suggestion_fix_tests" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_ai_suggestion" android:padding="12dp" android:text="Fix a bug\nand run tests" android:textColor="@color/ai_text" android:textSize="12sp" android:clickable="true" android:focusable="true" />
                        </LinearLayout>

                        <TextView android:id="@+id/ai_empty_chat_hint" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_ai_harness_badge" android:gravity="center" android:text="◯" android:textColor="@color/ai_text" android:visibility="gone" />
                        <HorizontalScrollView android:id="@+id/ai_suggestion_strip" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>

                        <LinearLayout android:id="@+id/ai_chat_messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />

                        <com.google.android.material.card.MaterialCardView android:id="@+id/ai_terminal_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" app:cardBackgroundColor="@color/ai_terminal" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
                                    <TextView android:id="@+id/ai_terminal_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ai_terminal_idle_title" android:textColor="@color/ai_terminal_text" android:textSize="11sp" android:textStyle="bold" />
                                    <com.google.android.material.button.MaterialButton android:id="@+id/ai_terminal_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="36dp" android:text="@string/ai_hide_terminal" android:textAllCaps="false" android:textColor="@color/ai_terminal_text" android:textSize="11sp" />
                                </LinearLayout>
                                <FrameLayout android:id="@+id/ai_terminal_container" android:layout_width="match_parent" android:layout_height="200dp" android:background="@color/ai_terminal">
                                    <com.termux.view.TerminalView android:id="@+id/ai_terminal_view" android:layout_width="match_parent" android:layout_height="match_parent" />
                                </FrameLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <LinearLayout android:id="@+id/ai_composer_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/ai_surface" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:elevation="8dp">
                    <HorizontalScrollView android:id="@+id/ai_chat_control_strip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:scrollbars="none">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/ai_provider_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="32dp" android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="OpenCode" android:textAllCaps="false" android:textSize="11sp" app:cornerRadius="16dp" app:strokeColor="@color/ai_border" app:icon="@drawable/ic_ai_package" app:iconSize="14dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/ai_model_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="32dp" android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/ai_model_auto" android:textAllCaps="false" android:textSize="11sp" app:cornerRadius="16dp" app:strokeColor="@color/ai_border" app:icon="@drawable/ic_ai_model" app:iconSize="14dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/ai_reasoning_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/ai_reasoning_auto" android:textAllCaps="false" android:textSize="11sp" app:cornerRadius="16dp" app:strokeColor="@color/ai_border" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/ai_approval_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/ai_approval_unless_trusted" android:textAllCaps="false" android:textSize="11sp" app:cornerRadius="16dp" app:strokeColor="@color/ai_border" app:icon="@drawable/ic_ai_check" app:iconSize="14dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/ai_thinking_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Thinking" android:textAllCaps="false" android:textSize="11sp" app:cornerRadius="16dp" app:strokeColor="@color/ai_border" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/ai_compact_button" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Compact" android:textAllCaps="false" android:textSize="11sp" app:cornerRadius="16dp" app:strokeColor="@color/ai_border" />
                        </LinearLayout>
                    </HorizontalScrollView>
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:id="@+id/ai_attachment_list" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_ai_composer" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/ai_attach_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="36dp" android:layout_height="36dp" android:minWidth="0dp" app:icon="@drawable/ic_ai_attach" app:iconPadding="0dp" app:cornerRadius="18dp" />
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/ai_prompt_input" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@android:color/transparent" android:hint="@string/ai_prompt_hint" android:textColor="@color/ai_text" android:textColorHint="@color/ai_text_muted" android:textSize="14sp" android:maxLines="4" android:inputType="textCapSentences|textMultiLine" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/ai_stop_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="36dp" android:layout_height="36dp" android:minWidth="0dp" app:icon="@drawable/ic_ai_stop" app:iconTint="@color/ai_warning" android:visibility="gone" app:cornerRadius="18dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/ai_chat_send_button" android:layout_width="36dp" android:layout_height="36dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:padding="0dp" app:iconPadding="0dp" app:iconGravity="textStart" app:icon="@drawable/ic_ai_send" app:cornerRadius="18dp" android:backgroundTint="@color/ai_accent" app:iconTint="@android:color/white" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/ai_sessions_page" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient_main" android:orientation="vertical" android:visibility="gone">
                <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none" android:overScrollMode="never">
                    <LinearLayout android:id="@+id/ai_sessions_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" />
                </ScrollView>
            </LinearLayout>
            <LinearLayout android:id="@+id/ai_opencode_page" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient_main" android:orientation="vertical" android:visibility="gone">
                <ScrollView android:id="@+id/ai_opencode_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none" android:overScrollMode="never">
                    <LinearLayout android:id="@+id/ai_opencode_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" />
                </ScrollView>
            </LinearLayout>
            <LinearLayout android:id="@+id/ai_extensions_page" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient_main" android:orientation="vertical" android:visibility="gone">
                <ScrollView android:id="@+id/ai_extensions_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none" android:overScrollMode="never">
                    <LinearLayout android:id="@+id/ai_extensions_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" />
                </ScrollView>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/ai_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_bottom_nav"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ai_folder" app:tint="@color/ai_text" /><TextView android:text="Home" android:textColor="@color/ai_text" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
            <LinearLayout android:id="@+id/nav_sessions" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ai_storage" app:tint="@color/ai_text" /><TextView android:text="Sessions" android:textColor="@color/ai_text" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
            <LinearLayout android:id="@+id/nav_shell" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ai_chat" app:tint="@color/ai_text" /><TextView android:text="Chat" android:textColor="@color/ai_text" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
