<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ai_background"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ai_top_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/ai_background"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/ai_menu_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_open_drawer"
                android:padding="13dp"
                android:src="@drawable/ic_ai_menu"
                app:tint="@color/ai_text" />

            <LinearLayout
                android:id="@+id/ai_title_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/ai_select_model_title"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ai_chat_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="220dp"
                    android:singleLine="true"
                    android:text="@string/ai_chat_title"
                    android:textColor="@color/ai_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="›"
                    android:textColor="@color/ai_text_muted"
                    android:textSize="20sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_model_button_placeholder"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/ai_settings_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_new_session"
                android:padding="13dp"
                android:src="@drawable/ic_ai_plus"
                app:tint="@color/ai_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/ai_chat_subtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/ai_page_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/ai_home_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ai_background"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="42dp">

                    <TextView
                        android:id="@+id/ai_home_title_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/ai_home_title"
                        android:textColor="@color/ai_text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ai_home_body_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/ai_home_body"
                        android:textColor="@color/ai_text_muted"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/ai_harness_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/ai_setup_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ai_background"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="22dp">

                    <TextView
                        android:id="@+id/ai_selected_harness_icon"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_ai_harness_badge"
                        android:gravity="center"
                        android:text="@string/ai_codex_mark"
                        android:textColor="@color/ai_text"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ai_selected_harness_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textColor="@color/ai_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ai_selected_harness_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/ai_text_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/ai_harness_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_ai_chip"
                        android:gravity="center"
                        android:textColor="@color/ai_text_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ai_workspace_input_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:hint="@string/ai_workspace_hint"
                        app:boxCornerRadiusBottomEnd="20dp"
                        app:boxCornerRadiusBottomStart="20dp"
                        app:boxCornerRadiusTopEnd="20dp"
                        app:boxCornerRadiusTopStart="20dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ai_workspace_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:singleLine="true"
                            android:textColor="@color/ai_text"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ai_browse_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/ai_browse"
                        android:textAllCaps="false"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_ai_folder"
                        app:iconPadding="8dp"
                        app:strokeColor="@color/ai_border" />

                    <TextView
                        android:id="@+id/ai_project_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ai_project_summary"
                        android:textColor="@color/ai_text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/ai_custom_command_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ai_custom_command_input_layout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/ai_custom_command_hint"
                            app:boxCornerRadiusBottomEnd="20dp"
                            app:boxCornerRadiusBottomStart="20dp"
                            app:boxCornerRadiusTopEnd="20dp"
                            app:boxCornerRadiusTopStart="20dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/ai_custom_command_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="textNoSuggestions"
                                android:singleLine="true"
                                android:textColor="@color/ai_text"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ai_login_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/ai_sign_in"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_ai_login"
                        app:iconPadding="8dp"
                        app:strokeColor="@color/ai_border" />

                    <TextView
                        android:id="@+id/ai_setup_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="@string/ai_setup_waiting"
                        android:textColor="@color/ai_text_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ai_start_button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/ai_continue"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        app:cornerRadius="22dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ai_install_button"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ai_check_button"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/ai_chat_page"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ai_background"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/ai_conversation_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="92dp">

                        <TextView
                            android:id="@+id/ai_empty_chat_hint"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_ai_harness_badge"
                            android:gravity="center"
                            android:text="@string/ai_codex_mark"
                            android:textColor="@color/ai_text"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:id="@+id/ai_suggestion_strip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="78dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/ai_suggestion_project_plan"
                                    android:layout_width="178dp"
                                    android:layout_height="64dp"
                                    android:background="@drawable/bg_ai_suggestion"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:text="Create a project plan\nfor this repo"
                                    android:textColor="@color/ai_text"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/ai_suggestion_fix_tests"
                                    android:layout_width="178dp"
                                    android:layout_height="64dp"
                                    android:layout_marginStart="10dp"
                                    android:background="@drawable/bg_ai_suggestion"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:text="Fix a bug\nand run tests"
                                    android:textColor="@color/ai_text"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <LinearLayout
                            android:id="@+id/ai_chat_messages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ai_terminal_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/ai_terminal"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:gravity="center_vertical"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="8dp">

                                    <TextView
                                        android:id="@+id/ai_terminal_title"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/ai_terminal_idle_title"
                                        android:textColor="@color/ai_terminal_text"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/ai_terminal_button"
                                        style="@style/Widget.MaterialComponents.Button.TextButton"
                                        android:layout_width="wrap_content"
                                        android:layout_height="44dp"
                                        android:text="@string/ai_hide_terminal"
                                        android:textAllCaps="false"
                                        android:textColor="@color/ai_terminal_text"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <FrameLayout
                                    android:id="@+id/ai_terminal_container"
                                    android:layout_width="match_parent"
                                    android:layout_height="260dp"
                                    android:background="@color/ai_terminal">

                                    <com.termux.view.TerminalView
                                        android:id="@+id/ai_terminal_view"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:defaultFocusHighlightEnabled="false"
                                        android:focusable="true"
                                        android:focusableInTouchMode="true"
                                        android:scrollbars="vertical" />
                                </FrameLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <LinearLayout
                    android:id="@+id/ai_composer_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ai_background"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <HorizontalScrollView
                        android:id="@+id/ai_chat_control_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ai_model_button"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="@string/ai_model_auto"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                app:cornerRadius="18dp"
                                app:icon="@drawable/ic_ai_model"
                                app:iconPadding="6dp"
                                app:strokeColor="@color/ai_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ai_reasoning_button"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="@string/ai_reasoning_auto"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                app:cornerRadius="18dp"
                                app:strokeColor="@color/ai_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ai_approval_button"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="@string/ai_approval_unless_trusted"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                app:cornerRadius="18dp"
                                app:icon="@drawable/ic_ai_check"
                                app:iconPadding="6dp"
                                app:strokeColor="@color/ai_border" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ai_thinking_button"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="Thinking compact"
                                android:textAllCaps="false"
                                android:textSize="12sp"
                                app:cornerRadius="18dp"
                                app:strokeColor="@color/ai_border" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/ai_attachment_list"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ai_composer"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ai_prompt_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical|start"
                            android:hint="@string/ai_prompt_hint"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="5"
                            android:minHeight="32dp"
                            android:textColor="@color/ai_text"
                            android:textColorHint="@color/ai_text_muted"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ai_attach_button"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@string/ai_attach_file"
                                android:minWidth="40dp"
                                android:padding="0dp"
                                android:text=""
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_ai_attach"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="@color/ai_text" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ai_stop_button"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@string/ai_stop"
                                android:minWidth="40dp"
                                android:padding="0dp"
                                android:text=""
                                android:visibility="gone"
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_ai_stop"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="@color/ai_warning" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/ai_chat_send_button"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:minWidth="40dp"
                                android:padding="0dp"
                                android:text=""
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_ai_send"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="@android:color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ai_drawer_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/ai_drawer_background"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_app_title"
            android:textColor="@color/ai_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/ai_app_subtitle"
            android:textColor="@color/ai_text_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_new_session_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:text="@string/ai_new_session"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_ai_plus"
            app:iconPadding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_open_shell_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/ai_open_shell"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_ai_terminal"
            app:iconPadding="8dp"
            app:strokeColor="@color/ai_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_storage_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical|start"
            android:text="@string/ai_enable_phone_storage"
            android:textAllCaps="false"
            android:textColor="@color/ai_text"
            android:textSize="13sp"
            app:icon="@drawable/ic_ai_storage"
            app:iconPadding="8dp"
            app:iconTint="@color/ai_text_muted" />

        <TextView
            android:id="@+id/ai_shell_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ai_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ai_activity_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ai_text_muted"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@color/ai_border" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_harnesses"
            android:textColor="@color/ai_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ai_drawer_harness_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ai_projects"
            android:textColor="@color/ai_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ai_projects_body"
            android:textColor="@color/ai_text_muted"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="invisible">

            <AutoCompleteTextView
                android:id="@+id/ai_harness_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:fadeScrollbars="false">

            <LinearLayout
                android:id="@+id/ai_recent_runs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ai_recent_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_recent_title"
                    android:textColor="@color/ai_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
